# Marabunta Worker Environment Configuration
# Copy this file to /etc/marabunta/worker.env and customize

# Logging level: trace, debug, info, warn, error
RUST_LOG=info

# Master URL (required)
MARABUNTA_MASTER_URL=http://localhost:9000

# Coordinator URL (for discovery)
MARABUNTA_COORDIGLOBAL_ALLIANCE_T1R_URL=http://localhost:8080

# Worker name (auto-generated if empty)
# MARABUNTA_WORKER_NAME=worker-01

# Number of CPU cores to use (0 = all available)
# MARABUNTA_WORKER_CORES=0

# Memory limit (e.g., 4G, 512M)
# MARABUNTA_WORKER_MEMORY=4G

# Data directory
# MARABUNTA_DATA_DIR=/var/lib/marabunta

# Enable idle detection
# MARABUNTA_IDLE_DETECTION=true
# MARABUNTA_IDLE_THRESHOLD=50
