# Marabunta Coordinator Environment Configuration
# Copy this file to /etc/marabunta/coordinator.env and customize

# Logging level: trace, debug, info, warn, error
RUST_LOG=info

# Bind address (overrides config file)
# MARABUNTA_COORDIGLOBAL_ALLIANCE_T1R_BIND=0.0.0.0:8080

# Data directory
# MARABUNTA_DATA_DIR=/var/lib/marabunta

# Enable TLS
# MARABUNTA_TLS_ENABLED=true
# MARABUNTA_TLS_CERT=/etc/marabunta/tls/cert.pem
# MARABUNTA_TLS_KEY=/etc/marabunta/tls/key.pem

# Authentication token
# MARABUNTA_AUTH_TOKEN=your-secret-token
