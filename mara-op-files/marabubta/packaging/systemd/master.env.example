# Marabunta Master Environment Configuration
# Copy this file to /etc/marabunta/master.env and customize

# Logging level: trace, debug, info, warn, error
RUST_LOG=info

# Bind address (overrides config file)
# MARABUNTA_MASTER_BIND=0.0.0.0:9000

# Coordinator URL
MARABUNTA_COORDIGLOBAL_ALLIANCE_T1R_URL=http://localhost:8080

# Data directory
# MARABUNTA_DATA_DIR=/var/lib/marabunta

# Scheduler settings
# MARABUNTA_SCHEDULER_ALGORITHM=priority
# MARABUNTA_TASK_TIMEOUT=1h

# Enable TLS
# MARABUNTA_TLS_ENABLED=true
# MARABUNTA_TLS_CERT=/etc/marabunta/tls/cert.pem
# MARABUNTA_TLS_KEY=/etc/marabunta/tls/key.pem
