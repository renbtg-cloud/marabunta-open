<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">#FF9800</item>
        <item name="colorPrimaryDark">#F57C00</item>
        <item name="colorAccent">#FFB300</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">#F57C00</item>

        <!-- Window background -->
        <item name="android:windowBackground">#FFFFFF</item>
    </style>

    <!-- Button style -->
    <style name="PrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- Card style -->
    <style name="CardStyle">
        <item name="android:background">@drawable/card_background</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- Title text style -->
    <style name="TitleText">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#333333</item>
    </style>

    <!-- Status text style -->
    <style name="StatusText">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#333333</item>
    </style>

    <!-- Stats text style -->
    <style name="StatsText">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#4CAF50</item>
    </style>

    <!-- Detail text style -->
    <style name="DetailText">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#999999</item>
    </style>

</resources>
